# Public configuration only. Never add a secret/service-role key to a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Public VAPID key only; private key/dispatch secret belong in Edge secrets.
VITE_VAPID_PUBLIC_KEY=
# Edge CORS is server-side configuration. Apply the production + localhost
# allowlist with: node scripts/supabase-cli.mjs origins
# Do not add ALLOWED_ORIGINS or privileged credentials to VITE_ variables.
## Enable only after private derivatives and the Singapore Edge flag are ready.
VITE_LMS_STORED_MEDIA_VARIANTS=0
